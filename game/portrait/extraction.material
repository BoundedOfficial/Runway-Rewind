name: "portrait_extraction"
tags: "portrait_quad"
vertex_program: "/portrait/quad.vp"
fragment_program: "/portrait/extraction.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "view_proj" type: CONSTANT_TYPE_VIEWPROJ }
vertex_constants { name: "rect" type: CONSTANT_TYPE_USER }
fragment_constants { name: "extraction" type: CONSTANT_TYPE_USER }
fragment_constants { name: "dimensions" type: CONSTANT_TYPE_USER }
samplers {
  name: "portrait"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
fragment_constants { name: "uv_basis_x" type: CONSTANT_TYPE_USER }
fragment_constants { name: "uv_basis_y" type: CONSTANT_TYPE_USER }
samplers {
  name: "splat"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
