local platform = require "platform.platform"
local artwork = require "portrait.artwork"
local runner = require "treatments.runner"
local sequence = require "treatments.level_one"
local target_guidance = require "main.target_guidance"

local POINTER = hash("pointer")
local INK = vmath.vector4(0.26, 0.13, 0.16, 1)
local IVORY = vmath.vector4(1, 0.92, 0.84, 1)
local REVEAL_HOLD = 0.65

local function box(x, y, width, height)
    return gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(width, height, 0))
end

local function text(x, y, caption, color)
    local node = gui.new_text_node(vmath.vector3(x, y, 0), caption)
    gui.set_font(node, "prompt")
    gui.set_color(node, color)
    return node
end

local function button(x, y, width, caption)
    local node = box(x, y, width, 54)
    gui.set_color(node, IVORY)
    gui.set_parent(text(0, 0, caption, INK), node)
    return node
end

local function treatment_hud()
    local background = box(320, 916, 254, 58)
    gui.set_color(background, vmath.vector4(0.19, 0.12, 0.12, 0.94))
    local label = text(0, 6, "", IVORY)
    gui.set_parent(label, background)
    local steps = {}
    for i = 1, #sequence do
        local step = box((i - (#sequence + 1) / 2) * 18, -12, 13, 4)
        gui.set_parent(step, background)
        steps[i] = step
    end
    gui.set_enabled(background, false)
    local instruction = text(320, 200, "Drag to a pimple and hold", IVORY)
    gui.set_enabled(instruction, false)
    return {
        background = background, label = label, steps = steps,
        guides = target_guidance.create(sequence), instruction = instruction,
    }
end

local function starting_treatment()
    if sys.get_engine_info().is_debug then
        local fixture = sys.get_config_string("runway.fixture")
        local treatment_id = ({ makeup = "foundation", finish = "hair-styling" })[fixture]
        for index, treatment in ipairs(sequence) do
            if treatment.id == treatment_id then return index end
        end
    end
    return 1
end

local function show_screen(self, screen)
    self.screen = screen
    gui.set_enabled(self.prompt, screen == "start")
    gui.set_enabled(self.replay, screen == "result")
    gui.set_enabled(self.next, screen == "result")
    gui.set_enabled(self.end_screen, screen == "end")
end

local function reset_stage(self)
    self.runner, self.reveal_remaining, self.pressed = nil, nil, nil
    self.first_unfinished = 1
    platform.save_run(0)
    show_screen(self, "start")
    gui.set_enabled(self.hud.background, false)
    target_guidance.clear(self.hud.guides)
    gui.set_enabled(self.hud.instruction, false)
    gui.set_enabled(self.tool, false)
    msg.post("@render:", "reset_portrait", { completed = {} })
    msg.post(".", "makeover_reset")
end

local function begin_run(self, first_unfinished)
    self.completed_treatments = first_unfinished - 1
    self.runner = runner.start(sequence, self.hud, self.tool, first_unfinished)
    if first_unfinished > #sequence then
        self.runner = nil
        show_screen(self, "result")
    else
        show_screen(self, nil)
    end
end

local function synchronize_platform(self)
    local state = platform.state()
    if state.audio_enabled ~= self.audio_enabled then
        sound.set_group_gain("master", state.audio_enabled and 1 or 0)
        self.audio_enabled = state.audio_enabled
    end
    if state.pause_count ~= self.pause_count then
        self.pause_count = state.pause_count
        self.pressed = false
        self.skip_input = true
        if self.runner then runner.cancel(self.runner, true) end
    end
    if state.restart_count ~= self.restart_count and not state.paused then
        self.restart_count = state.restart_count
        self.pressed = false
        self.skip_input = true
        reset_stage(self)
    end
    return state.paused
end

function init(self)
    self.prompt = button(320, 72, 218, "Start makeover")
    self.hud = treatment_hud()
    self.tool = box(0, 0, 118, 118)
    gui.set_texture(self.tool, "tools")
    gui.set_enabled(self.tool, false)
    self.replay = button(241, 72, 140, "Replay")
    self.next = button(399, 72, 140, "Next")
    self.end_screen = box(320, 480, 640, 960)
    gui.set_color(self.end_screen, vmath.vector4(0.14, 0.12, 0.10, 0.90))
    gui.set_parent(text(0, 38, "More makeovers coming soon", IVORY), self.end_screen)
    self.end_replay = button(0, -38, 140, "Replay")
    gui.set_parent(self.end_replay, self.end_screen)
    show_screen(self, nil)
    self.first_unfinished = starting_treatment()
    self.pause_count, self.restart_count = 0, 0
    msg.post(".", "acquire_input_focus")
    platform.listen_for_editor_focus()
    platform.prepare_run(#sequence)
end

function update(self, dt)
    if not self.interactive then
        if not self.restored then
            local restored = platform.initial_run()
            if not restored.ready then return end
            if restored.boundary and restored.boundary > 0 then
                begin_run(self, restored.boundary + 1)
            else
                if restored.boundary == 0 then self.first_unfinished = 1 end
                show_screen(self, "start")
            end
            self.restored = true
            -- Draw the reconstructed stage before handing input to the player.
            return
        end
        self.interactive = true
        platform.stage_ready()
    end
    if synchronize_platform(self) then return end
    -- Discard the first tick's accumulated wall time and pending engine input.
    if self.skip_input then
        self.skip_input = false
        return
    end
    if self.runner then
        local completed, exited = runner.update(self.runner, dt)
        if completed then
            self.completed_treatments = self.completed_treatments + 1
            platform.save_run(self.completed_treatments)
            msg.post(".", "treatment_completed", { treatment = completed })
        end
        if exited then
            self.runner = nil
            self.reveal_remaining = REVEAL_HOLD
        end
    elseif self.reveal_remaining then
        self.reveal_remaining = self.reveal_remaining - dt
        if self.reveal_remaining <= 0 then
            self.reveal_remaining = nil
            show_screen(self, "result")
        end
    end
end

local function picked_button(self, x, y)
    if self.screen == "start" and gui.pick_node(self.prompt, x, y) then
        return self.prompt
    elseif self.screen == "result" then
        if gui.pick_node(self.replay, x, y) then return self.replay end
        if gui.pick_node(self.next, x, y) then return self.next end
    elseif self.screen == "end" and gui.pick_node(self.end_replay, x, y) then
        return self.end_replay
    end
end

function on_input(self, action_id, action)
    if not self.interactive or synchronize_platform(self) or self.skip_input then return true end
    if self.runner then
        if (action_id == POINTER or not action_id) and action.x and action.y then
            runner.input(self.runner, action.x, artwork.height - action.y,
                action.pressed, action.released, action_id == POINTER)
        end
        return
    end
    if action_id ~= POINTER then
        return
    end
    local picked = picked_button(self, action.x, action.y)
    if action.pressed then
        self.pressed = picked
        return picked ~= nil
    elseif action.released then
        local activated = picked and picked == self.pressed
        self.pressed = nil
        if not activated then return end
        if picked == self.prompt then
            begin_run(self, self.first_unfinished)
            msg.post(".", "makeover_started")
        elseif picked == self.next then
            show_screen(self, "end")
        else
            reset_stage(self)
        end
        return true
    end
end
